# Copie para .env e preencha. As variaveis marcadas [infra] sao mantidas em dia
# pelo infra/scripts/sync_host_ip.py — edite no infra/.env, nao aqui.

# --- banco (local deste projeto) -------------------------------------------
POSTGRES_USER=controle_despesa
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=controle_despesa
POSTGRES_DB_TEST=controle_despesa_test

# --- SSO --------------------------------------------------------------------
# [infra] IP fixo da maquina que hospeda os cinco sistemas.
HOST_IP=10.0.0.143
# [infra] segredo do client controle-despesa-web no realm ufc.
CONTROLE_DESPESA_CLIENT_SECRET=
# Local deste projeto: chave da sessao. Gere com `openssl rand -hex 32`.
# Trocar invalida todas as sessoes abertas.
CONTROLE_DESPESA_SESSION_SECRET=
OIDC_REQUIRED_GROUP=/apps/controle-despesa
# [infra] conta mestra: entra como admin sem depender de grupo.
ADMIN_MESTRE_EMAIL=

# --- portas -----------------------------------------------------------------
# [infra] a deste sistema e as dos outros, para o seletor "Sistemas".
CONTROLE_DESPESA_PORT=3050
PORTAL_PORT=3080
INVENTARIO_PORT=3030
RECEITA_PORT=3040
DESPESA_PORT=3010

# --- backup -----------------------------------------------------------------
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# --- app --------------------------------------------------------------------
# prod no servidor; o docker-compose.override.yml de desenvolvimento troca por dev.
APP_CONFIG=prod
